+    def _log_stuck_restart_completion(self, level: int, summary: dict[str, Any]) -> None:
+        """Log, once, that a restarted level was then completed. No-op unless that level was restarted."""
+        restarted = getattr(self, "_stuck_restarts", None) or {}
+        event = restarted.get(level)
+        if event is None or event.get("completion_logged"):
+            return
+        event["completion_logged"] = True
+        done = {k: v for k, v in event.items() if k != "completion_logged"}
+        done.update(
+            event="completed_after_restart",
+            tokens_after=self._session_generated_tokens - event["session_tokens_at_restart"],
+            actions_total=_priority_action_count(summary) - self._actions_at_level_start,
+        )
+        log.warning("stuck_level_restart: level %d completed after restart (%d more tokens)",
+                    level, done["tokens_after"])
+        _stuck_restart_log(done)
+
+    def _maybe_restart_stuck_level(self, state_path: Path, append_transcript) -> str:
+        """Clear this level's conversation once it has used ARC3_STUCK_RESTART_TOKENS.
+
+        Called at the start of every analyze() invocation, before the rollback
+        snapshot, where nothing is in flight. It also fires on an invocation the
+        solver re-issued after a turn that executed nothing: a model deliberating
+        without acting is the most stuck case, and once the history is gone there
+        is nothing to resume, so the turn opens as a fresh one with the full
+        prompt and the board. At most once per level. The system prompt, the
+        retained functions and the board stay; the level's messages go. The level
+        keeps its token count, so the gate prices the game as with the flag off;
+        the dropped prefix is flagged to it exactly as a context trim is, which
+        gives up the slot once.
+        Returns the line to put before this turn's prompt, or "" when nothing was
+        cleared. If the turn that carried the line is rolled back (request
+        failure, discarded multi-call turn), the line is sent again.
+        """
+        limit = _stuck_restart_tokens()
+        if limit <= 0:
+            return ""
+        restarted = getattr(self, "_stuck_restarts", None)
+        if restarted is None:
+            restarted = self._stuck_restarts = {}
+        summary = self._last_step_summary or {}
+        level = int(summary.get("level") or 1)
+        pending = getattr(self, "_stuck_restart_note", "")
+        if pending:
+            same_attempt = getattr(self, "_stuck_restart_note_at", None) == (level, _priority_action_count(summary))
+            if self._history_messages or not same_attempt:
+                self._stuck_restart_note = ""      # the turn that carried it was kept, or the game moved on
+            else:
+                self._resume_after_yield = False   # it was rolled back: say it again
+                self._resume_reason = ""
+                return pending
+        tokens = self._session_generated_tokens - getattr(self, "_tokens_at_level_start", 0)
+        if level in restarted or tokens < limit or not self._history_messages:
+            return ""
+        actions = max(0, _priority_action_count(summary) - self._actions_at_level_start)
+        event = {
+            "event": "restart", "state_path": str(state_path), "slot": self._diag_name,
+            "level": level, "tokens_before": tokens, "actions_before": actions,
+            "messages_dropped": len(self._history_messages),
+            "resumed_turn": bool(getattr(self, "_resume_after_yield", False)),
+            "game_over": bool(summary.get("game_over")),
+            "session_tokens_at_restart": self._session_generated_tokens,
+            "elapsed_s": getattr(self, "_game_elapsed_seconds", None),
+        }
+        restarted[level] = event
+        self._history_messages = []
+        self._resume_after_yield = False
+        self._resume_reason = ""
+        self._note_history_evicted()
+        log.warning(
+            "stuck_level_restart: level %d after %d tokens and %d actions; %d messages dropped",
+            level, tokens, actions, event["messages_dropped"],
+        )
+        append_transcript(
+            "ANALYZER STATUS",
+            f"stuck_level_restart: level={level} tokens={tokens} actions={actions} "
+            f"messages_dropped={event['messages_dropped']}",
+        )
+        _stuck_restart_log(event)
+        board = (
+            "The board below is the level's starting state: it was reset after a game over."
+            if event["game_over"] else
+            "The board below is the level's current state, which may differ from its start."
+        )
+        self._stuck_restart_note_at = (level, _priority_action_count(summary))
+        self._stuck_restart_note = (
+            f"Your earlier conversation on this level was cleared after {actions} actions "
+            f"without completing it. {board} Your retained functions are still available."
+        )
+        return self._stuck_restart_note
+
